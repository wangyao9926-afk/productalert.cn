# Local default. You can omit this line and the app will use data/monitor.db.
DATABASE_URL=sqlite:///data/monitor.db

# Browser/API security. Production must use HTTPS origins and secure cross-site cookies.
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4175,http://localhost:4175
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Used to build evidence links inside notification messages.
# APP_PUBLIC_URL=https://app.productalert.cn

# PostgreSQL smoke-test target. Use an isolated test database first.
# Run: .\.venv\Scripts\python.exe -m app.db_postgresql_smoke
# DATABASE_URL=postgresql://product_monitor:change-me@localhost:5432/product_monitor

# Optional crawler tuning.
# CRAWLER_DOMAIN_DELAY_SECONDS=1.0

# Queue backend. Use in_process locally; use rq with REDIS_URL for external workers.
QUEUE_BACKEND=in_process
# QUEUE_BACKEND=rq
# Run: .\.venv\Scripts\python.exe -m app.rq_preflight
# Run smoke: .\.venv\Scripts\python.exe -m app.rq_smoke
# Run scan smoke: .\.venv\Scripts\python.exe -m app.rq_scan_smoke
# Run worker: .\start-rq-worker.ps1
# REDIS_URL=redis://localhost:6379/0

# FastAPI startup background loops. Disable for API-only deployments.
START_BACKGROUND_WORKERS=true

# Notification worker. Keep enabled for local all-in-one startup; disable when
# running notification delivery as a separate worker process.
START_NOTIFICATION_WORKER=true
# Run worker: .\start-notification-worker.ps1

# Release gate. Use an isolated database URL when running this before deploy.
# Run: .\.venv\Scripts\python.exe -m app.production_readiness_smoke
# PostgreSQL deploy guard:
# Run: .\.venv\Scripts\python.exe -m app.production_readiness_smoke --require-backend postgresql
# RQ/Redis deploy guard:
# Run: .\.venv\Scripts\python.exe -m app.production_readiness_smoke --require-queue rq
# PowerShell wrapper:
# Run local: .\deploy-check.ps1 -Backend sqlite -Queue in_process
# Run RQ: .\deploy-check.ps1 -Backend sqlite -Queue rq -RedisUrl redis://localhost:6379/0
# Run PostgreSQL+RQ: .\deploy-check.ps1 -Backend postgresql -Queue rq -DatabaseUrl postgresql://product_monitor:change-me@localhost:5432/product_monitor -RedisUrl redis://localhost:6379/0
# Run production API:
# .\start-api-production.ps1 -DatabaseUrl postgresql://product_monitor:change-me@localhost:5432/product_monitor -Queue rq -RedisUrl redis://localhost:6379/0
# Preview Windows scheduled tasks:
# .\install-windows-tasks.ps1 -DryRun -DatabaseUrl postgresql://product_monitor:change-me@localhost:5432/product_monitor -RedisUrl redis://localhost:6379/0

# Local PostgreSQL bootstrap helper. Requires psql on PATH.
# Preview SQL: .\setup-postgres-local.ps1 -PrintOnly
# Bootstrap: .\setup-postgres-local.ps1 -RunDeployCheck
# If psql is not on PATH:
# .\setup-postgres-local.ps1 -PsqlPath "C:\Program Files\PostgreSQL\18\bin\psql.exe" -AdminPassword your-postgres-password -RunDeployCheck
