# Production profile for the product monitor.
# Copy to .env on the target host and replace every placeholder before launch.

# Public HTTPS boundary. Keep the API hostname and frontend hostname separate.
APP_ENV=production
APP_PUBLIC_URL=https://<your-api-domain>
CORS_ALLOWED_ORIGINS=https://<your-frontend-domain>

# PostgreSQL is required for production.
DATABASE_URL=postgresql://product_monitor:replace-with-strong-password@127.0.0.1:5432/product_monitor

# External queue workers are required for production scans.
QUEUE_BACKEND=rq
REDIS_URL=redis://127.0.0.1:6379/0

# API process should not run scan/scheduler/notification background loops.
START_BACKGROUND_WORKERS=false
START_NOTIFICATION_WORKER=false

# Use Secure cookies only when the site is served through HTTPS.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none

# Optional crawler tuning.
CRAWLER_DOMAIN_DELAY_SECONDS=1.0
